{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e45recordings.com/schemas/akai-tools/aim-export-program-request-v1.json",
  "title": "EDIT950 export program request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "protocolVersion", "messageType", "requestID", "createdAt", "sender", "response", "source", "program", "observedDependencies"],
  "properties": {
    "protocol": { "const": "com.e45recordings.akai-tools" },
    "protocolVersion": { "const": 1 },
    "messageType": { "const": "aim.export-program.request" },
    "requestID": { "type": "string", "format": "uuid" },
    "createdAt": { "type": "string", "format": "date-time" },
    "sender": { "$ref": "common-definitions-v1.json#/$defs/sender" },
    "response": { "$ref": "common-definitions-v1.json#/$defs/responseTransport" },
    "source": { "$ref": "common-definitions-v1.json#/$defs/source" },
    "program": { "$ref": "common-definitions-v1.json#/$defs/nativeProgram" },
    "observedDependencies": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "common-definitions-v1.json#/$defs/dependency" }
    },
    "openInTRUE950AfterExport": { "type": "boolean", "default": false }
  }
}
